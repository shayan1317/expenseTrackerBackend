{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext", // ya CommonJS, jo tum use karna chahte ho
    "moduleResolution": "node", // ✅ important
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false // default
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
