generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url      = env("DATABASE_URL_DEV")
}
model User {
id            String   @id @default(uuid())
email         String   @unique
full_name     String
password_hash String
created_at    DateTime @default(now())
image         String
incomes   Income[]
expenses  Expense[]

}

model Income {
id        String   @id @default(uuid())
amount    Float
title     String
createdAt DateTime @default(now())
userId    String
user      User     @relation(fields: [userId], references: [id])
notes     String?
date      DateTime @default(now())
incomeSourceIconLabel    String   @default("💰")
updatedAt DateTime @default(now())
transactionType String?
}

model Expense {
id        String   @id @default(uuid())
amount    Float
title     String
createdAt DateTime @default(now())
userId    String
user      User     @relation(fields: [userId], references: [id])
notes     String?
date      DateTime @default(now())
expenseIconLabel    String  @default("💰")
updatedAt DateTime @default(now())
transactionType String?
}